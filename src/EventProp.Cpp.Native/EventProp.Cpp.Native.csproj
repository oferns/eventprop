<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Copy native libraries to output directory -->
  <ItemGroup>
    <!-- C++ wrapper library (P/Invoke bindings — includes Eigen core) -->
    <NativeLibrary Include="../EventProp.Cpp.Wrapper/build/libeventprop_cpp_wrapper.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </NativeLibrary>
  </ItemGroup>

</Project>
