<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EventProp/EventProp.csproj" />
    <ProjectReference Include="../EventProp.Native/EventProp.Native.csproj" />
    <ProjectReference Include="../EventProp.Cpp.Native/EventProp.Cpp.Native.csproj" />
  </ItemGroup>

  <!-- Copy native libraries to output directory for P/Invoke -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <!-- C library (NativeApi) -->
    <None Include="..\EventProp.C\build\libeventprop_c_api.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libeventprop_c_api.dylib</TargetPath>
    </None>
    <!-- C++ wrapper library (NativeCppApi) -->
    <None Include="..\EventProp.Cpp.Wrapper\build\libeventprop_cpp_wrapper.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libeventprop_cpp_wrapper.dylib</TargetPath>
    </None>
  </ItemGroup>

</Project>
