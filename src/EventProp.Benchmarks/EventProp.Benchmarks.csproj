<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EventProp/EventProp.csproj" />
    <ProjectReference Include="../EventProp.Native/EventProp.Native.csproj" />
  </ItemGroup>

  <!-- Copy native libraries to output directory for P/Invoke -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <!-- C library (NativeApi) -->
    <None Include="..\EventProp.C\build\libeventprop_c_api.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libeventprop_c_api.dylib</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- C library (NativeApi) -->
    <None Include="..\EventProp.C\build\Release\eventprop_c_api.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>eventprop_c_api.dll</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <!-- C library (NativeApi) -->
    <None Include="..\EventProp.C\build\libeventprop_c_api.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libeventprop_c_api.so</TargetPath>
    </None>
  </ItemGroup>

</Project>