<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CW.EventProp.Native</RootNamespace>
    <AssemblyName>CW.EventProp.Native</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EventProp.Abstractions/EventProp.Abstractions.csproj" />
  </ItemGroup>

  <!-- Copy native library to output directory -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="..\EventProp.C\build\libeventprop_c_api.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libeventprop_c_api.dylib</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="..\EventProp.C\build\Release\eventprop_c_api.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>eventprop_c_api.dll</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="..\EventProp.C\build\libeventprop_c_api.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libeventprop_c_api.so</TargetPath>
    </None>
  </ItemGroup>

</Project>
