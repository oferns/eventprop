<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CW.EventProp.Tests</RootNamespace>
    <AssemblyName>CW.EventProp.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="TUnit" Version="1.45.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EventProp/EventProp.csproj" />
    <ProjectReference Include="../EventProp.Native/EventProp.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit" />
  </ItemGroup>

  <!-- Copy native C library to output directory -->
  <Target Name="CopyNativeLib" BeforeTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../EventProp.C/libeventprop_c_api.dylib" DestinationFolder="$(OutDir)" Condition="Exists('$(MSBuildThisFileDirectory)../EventProp.C/libeventprop_c_api.dylib')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../EventProp.Cpp.Wrapper/build/libeventprop_cpp_wrapper.dylib" DestinationFolder="$(OutDir)" Condition="Exists('$(MSBuildThisFileDirectory)../EventProp.Cpp.Wrapper/build/libeventprop_cpp_wrapper.dylib')" />
  </Target>

</Project>
