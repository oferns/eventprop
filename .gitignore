# Test results and coverage output
# No blanket `*.html`: coverage-report/ and TestResults/ are named above, and a
# repo-wide *.html silently blocks committing any future HTML (docs, reports).
TestResults/
coverage-report/
*.coverage
*.cobertura.xml
*.trx

# CMake build output
build/
build-werror/
# Machine-local CMake presets companion (per-developer, not shared)
CMakeUserPresets.json
# Generated by CMake for clangd/IDE — platform-specific paths
compile_commands.json

# Build artifacts (MSBuild)
**/*.dll
!**/*.Designer.dll
*.dylib
**/*.pdb
!**/*.Designer.pdb

# User-specific files
*.user
*.suo

# Backup and report files
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# Microsoft Azure Build Agent
azure-pipelines.yml

# BenchmarkDotNet artifacts
BenchmarkDotNet.Artifacts/

# vcpkg (C++ package manager) — not vendored in this repo; kept for local use
tools/vcpkg/

# Python
__pycache__/
*.pyc
.benchmarks/
.venv/

# clangd cache
src/EventProp.C/.cache/
src/EventProp.C/.clangd

# Benchmark pipeline output (scripts/bench/run_all.py).
# Ignored, not committed: these are machine-specific measurements, and merge.py
# refuses to merge records from different hosts, so a committed record file is a
# measurement nobody on another machine can use. Filenames carry the platform tag
# (records_darwin-arm64_native_c.json, merged_linux-x86_64.json, ...) so results
# from several machines coexist in one directory. BENCHMARKS.md IS committed - it
# is the generated report, and the committed copy states which host produced it.
bench-results/
