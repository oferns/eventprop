UpgradeLog*.htm

# Microsoft Azure Build Agent
azure-pipelines.yml

# BenchmarkDotNet artifacts
BenchmarkDotNet.Artifacts/

# vcpkg (C++ package manager) — not vendored in this repo; kept for local use
tools/vcpkg/

# Python
__pycache__/
*.pyc
.benchmarks/
.venv/
# Editable-install metadata (`pip install -e .`) lands next to the package. The
# Cython package already ignores it locally; this covers every package, because
# `untracked` is a REPORTED provenance field in every benchmark record (see
# scripts/bench/provenance.py) — a build artifact leaking into it is noise in the
# artifact that is supposed to say whether a run measured a clean tree.
*.egg-info/

# clangd cache
src/EventProp.C/.cache/
src/EventProp.C/.clangd

# Benchmark pipeline output (scripts/bench/run_all.py).
# Ignored, not committed: these are machine-specific measurements, and merge.py
# refuses to merge records from different hosts, so a committed record file is a
# measurement nobody on another machine can use. Filenames carry the platform tag
# (records_darwin-arm64_native_c.json, merged_linux-x86_64.json, ...) so results
# from several machines coexist in one directory.
#
# The COMMITTED counterpart is bench-reports/ (report_<tag>.md): the report is the
# artifact that survives being read on a different machine, it is deterministic
# (byte-identical across runs of the same records) and it is small (~24K). It
# carries vcs_rev, vcs_dirty and date in its header so staleness is visible.
bench-results/
