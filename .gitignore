# Test results and coverage output
# No blanket `*.html`: coverage-report/ and TestResults/ are named above, and a
# repo-wide *.html silently blocks committing any future HTML (docs, reports).
TestResults/
coverage-report/
*.coverage
*.cobertura.xml
*.trx

# CMake build output
build/
build-werror/
# CTest scratch written next to the source tree when ctest is invoked with --test-dir
# or --build-and-test (LastTest.log, cost data). Not a build output anyone reads.
Testing/
# Machine-local CMake presets companion (per-developer, not shared)
CMakeUserPresets.json
# Generated by CMake for clangd/IDE — platform-specific paths
compile_commands.json

# Build artifacts (MSBuild)
**/*.dll
!**/*.Designer.dll
*.dylib
**/*.pdb
!**/*.Designer.pdb

