         )
+        # All-to-all weights: with one input spike per pre-synaptic neuron, diagonal
+        # weights never drive a post-synaptic neuron past v_th.
+        w = np.ones((params.lif_parameters.n, params.lif_parameters.n)) * 2.0
 
         def get_artificial_output(t_eps, batch_idx, spike_idx):
