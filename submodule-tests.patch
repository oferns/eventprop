+            # cannot bracket a spike before it. The Eigen reference does not validate
+            # them, so it silently evaluates the extrapolation; the C library rejects
+            # them with EVENTPROP_NEGATIVE_SPIKE_TIME (7).
+            times1 = (np.arange(params.lif_parameters.n) + 1) * 0.001
