+        # every first_spike_time was NaN and the numerical leg of this test compared
+        # NaN against a legitimate analytical 0.0. A comparison that only passes when
+        # both sides are NaN measures nothing.
+        np.random.seed(42)
         params = TTFSCrossEntropyLossParameters(
